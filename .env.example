# Core (required)
DATABASE_URL=postgresql://salonflow:replace-me@127.0.0.1:5432/salonflow?schema=public
NEXTAUTH_URL=https://salon.example.com
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
CUSTOMER_ACCESS_SECRET=replace-with-an-independent-32-character-secret
FIELD_WEBHOOK_SECRET=replace-with-an-independent-32-character-secret
CORS_ORIGINS=https://salon.example.com
HOST=0.0.0.0
PORT=3000

# Licensed provider adapters (required for the corresponding workflow)
MAP_PROVIDER_URL=https://maps-provider.example.com/operations
MAP_PROVIDER_TOKEN=replace-me
CALENDAR_PROVIDER_URL=https://calendar-provider.example.com/operations
CALENDAR_PROVIDER_TOKEN=replace-me
MESSAGE_PROVIDER_URL=https://message-provider.example.com/operations
MESSAGE_PROVIDER_TOKEN=replace-me
TAX_PROVIDER_URL=https://tax-provider.example.com/operations
TAX_PROVIDER_TOKEN=replace-me
PAYMENT_PROVIDER_URL=https://payment-provider.example.com/operations
PAYMENT_PROVIDER_TOKEN=replace-me
ACCOUNTING_PROVIDER_URL=https://accounting-provider.example.com/operations
ACCOUNTING_PROVIDER_TOKEN=replace-me

# Transactional email and SMS
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=replace-me
FROM_EMAIL=operations@example.com
TWILIO_ACCOUNT_SID=replace-me
TWILIO_AUTH_TOKEN=replace-me
TWILIO_PHONE_NUMBER=replace-me

# Web push and optional horizontal scale
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:operations@example.com
REDIS_URL=
SOCKET_AUTH_TOKEN=
