{
  "name": "salonflow-operations",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node --project tsconfig.server.json server.ts",
    "dev:next": "next dev",
    "build": "next build && tsc --project tsconfig.server.json",
    "start": "node dist/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "yarn test:unit && yarn test:integration",
    "test:unit": "tsx --test test/unit/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 test/integration/*.test.ts",
    "db:migrate": "prisma migrate deploy",
    "create-admin": "node scripts/provision-admin.cjs",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.5",
    "@mui/material": "^7.3.5",
    "@mui/material-nextjs": "^7.3.5",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "date-fns": "^4.1.0",
    "next": "16.2.10",
    "next-auth": "^4.24.14",
    "jsonwebtoken": "^9.0.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "stripe": "^16.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^24.10.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "resolutions": {
    "postcss": "8.5.10",
    "preact": "10.29.7",
    "qs": "6.15.2",
    "uuid": "11.1.1",
    "yaml": "1.10.3",
    "ws": "8.21.1"
  }
}
